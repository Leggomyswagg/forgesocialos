{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, configuration preferences, and aggregated activity metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID matching auth UID", "maxLength": 128 },
        "email": { "type": "string", "description": "User email address", "maxLength": 256 },
        "displayName": { "type": "string", "description": "User display name", "maxLength": 128 },
        "photoURL": { "type": "string", "description": "User avatar photo URL", "maxLength": 1024 },
        "themeAccent": { "type": "string", "description": "Preferred accent color", "enum": ["orange", "lime"] },
        "defaultFont": { "type": "string", "description": "Preferred typography font", "maxLength": 64 },
        "defaultAspectRatio": { "type": "string", "description": "Default canvas ratio", "enum": ["4:5", "9:16", "1:1"] },
        "defaultBusiness": { "type": "string", "description": "Saved business or brand name", "maxLength": 256 },
        "defaultAudience": { "type": "string", "description": "Saved target audience description", "maxLength": 512 },
        "defaultGoal": { "type": "string", "description": "Saved primary campaign goal", "maxLength": 256 },
        "forgedAssetsCount": { "type": "number", "description": "Total count of forged assets created" },
        "lastActiveAt": { "type": "string", "description": "ISO timestamp of last activity" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Profile update timestamp" }
      },
      "required": ["id", "email", "createdAt", "updatedAt"]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "Activity log entry tracking user actions, campaigns, and asset generations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique activity ID", "maxLength": 128 },
        "userId": { "type": "string", "description": "Auth UID of the user who performed the action", "maxLength": 128 },
        "actionType": { "type": "string", "description": "Type of activity action performed", "maxLength": 64 },
        "title": { "type": "string", "description": "Summary title of the activity", "maxLength": 256 },
        "details": { "type": "string", "description": "Supplementary context or metadata", "maxLength": 1024 },
        "createdAt": { "type": "string", "description": "Timestamp when activity occurred" }
      },
      "required": ["id", "userId", "actionType", "title", "createdAt"]
    },
    "ForgedAsset": {
      "title": "ForgedAsset",
      "description": "Saved forged marketing asset package generated by the Forge Method",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique asset ID", "maxLength": 128 },
        "userId": { "type": "string", "description": "Auth UID of the user owner", "maxLength": 128 },
        "business": { "type": "string", "description": "Business or product title", "maxLength": 256 },
        "audience": { "type": "string", "description": "Target audience description", "maxLength": 512 },
        "goal": { "type": "string", "description": "Campaign conversion goal", "maxLength": 256 },
        "themeAccent": { "type": "string", "description": "Color accent used", "enum": ["orange", "lime"] },
        "font": { "type": "string", "description": "Font family used", "maxLength": 64 },
        "aspectRatio": { "type": "string", "description": "Aspect ratio chosen", "enum": ["4:5", "9:16", "1:1"] },
        "hookRate": { "type": "number", "description": "Predicted hook rate percentage" },
        "ctr": { "type": "number", "description": "Predicted click through rate percentage" },
        "roas": { "type": "number", "description": "Predicted return on ad spend multiplier" },
        "createdAt": { "type": "string", "description": "Timestamp when asset was forged" }
      },
      "required": ["id", "userId", "business", "createdAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User submitted feedback, bug report, or feature suggestion",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique feedback ID", "maxLength": 128 },
        "userId": { "type": "string", "description": "Auth UID of the user submitter", "maxLength": 128 },
        "userName": { "type": "string", "description": "User display name or email", "maxLength": 128 },
        "type": { "type": "string", "description": "Classification of feedback", "enum": ["feature_suggestion", "bug_report", "general_feedback"] },
        "title": { "type": "string", "description": "Brief summary of the suggestion or issue", "maxLength": 256 },
        "description": { "type": "string", "description": "Full details of feedback", "maxLength": 2048 },
        "rating": { "type": "number", "description": "Optional star rating from 1 to 5" },
        "status": { "type": "string", "description": "Status of the feedback item", "enum": ["open", "in_review", "resolved"] },
        "createdAt": { "type": "string", "description": "Timestamp when feedback was submitted" }
      },
      "required": ["id", "userId", "type", "title", "description", "status", "createdAt"]
    },
    "CampaignMetric": {
      "title": "CampaignMetric",
      "description": "Daily performance metric for marketing campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique metric entry ID", "maxLength": 128 },
        "userId": { "type": "string", "description": "Auth UID of the user owner", "maxLength": 128 },
        "date": { "type": "string", "description": "Date string (YYYY-MM-DD)", "maxLength": 32 },
        "campaignName": { "type": "string", "description": "Name of campaign", "maxLength": 256 },
        "channel": { "type": "string", "description": "Marketing channel", "maxLength": 64 },
        "impressions": { "type": "number", "description": "Impression volume" },
        "clicks": { "type": "number", "description": "Click count" },
        "conversions": { "type": "number", "description": "Conversion count" },
        "spend": { "type": "number", "description": "Total ad spend in USD" },
        "revenue": { "type": "number", "description": "Generated revenue in USD" },
        "ctr": { "type": "number", "description": "Click-through rate %" },
        "cvr": { "type": "number", "description": "Conversion rate %" },
        "roas": { "type": "number", "description": "Return on ad spend" },
        "hookRate": { "type": "number", "description": "3-second video hook rate %" },
        "cpa": { "type": "number", "description": "Cost per acquisition in USD" },
        "createdAt": { "type": "string", "description": "Timestamp of creation", "maxLength": 64 }
      },
      "required": ["id", "userId", "date", "campaignName", "channel", "impressions", "clicks", "conversions", "spend", "revenue", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities/UserProfile" },
      "description": "User profile with configuration preferences and statistics"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": { "$ref": "entities/UserActivity" },
      "description": "User activity log entries"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": { "$ref": "entities/ForgedAsset" },
      "description": "User's saved and forged marketing asset packages"
    },
    "/users/{userId}/metrics/{metricId}": {
      "schema": { "$ref": "entities/CampaignMetric" },
      "description": "Daily campaign analytics and performance metrics"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "entities/Feedback" },
      "description": "User submitted feedback and bug reports"
    }
  }
}
